From: sanders-linux-mainline <noreply@example.com>
Subject: [PATCH] wcn36xx: add dialog_token to hal_tx_compl_ind_msg

WCN3680 Pronto FW (e.g. Motorola sanders stock 1.5.1.2) sends 8 bytes
of payload (status + dialog_token) in TX_COMPL indication, matching the
downstream prima `tTxComplIndMsg` struct. Mainline only has 4 bytes
(status), so `len != sizeof(*rsp)` trips, the warning "Bad TX complete
indication" is emitted and the TX-ack info is dropped (`-EIO`).

This may starve the firmware of TX-ack feedback and contribute to the
MEM_FAIL=5 cascade on hal_config_bss observed on this hardware.

diff --git a/drivers/net/wireless/ath/wcn36xx/hal.h b/drivers/net/wireless/ath/wcn36xx/hal.h
index ef9ea4ff8..77d8455fa 100644
--- a/drivers/net/wireless/ath/wcn36xx/hal.h
+++ b/drivers/net/wireless/ath/wcn36xx/hal.h
@@ -1946,16 +1946,6 @@ struct wcn36xx_hal_config_bss_params {
 	/* Reserved to align next field on a dword boundary */
 	u8 reserved;
 
-	/* TODO move sta to the end for 3680 */
-	/* Context of the station being added in HW
-	 *  Add a STA entry for "itself" -
-	 *
-	 *  On AP  - Add the AP itself in an "STA context"
-	 *
-	 *  On STA - Add the AP to which this STA is joining in an
-	 *  "STA context"
-	 */
-	struct wcn36xx_hal_config_sta_params sta;
 	/* SSID of the BSS */
 	struct wcn36xx_hal_mac_ssid ssid;
 
@@ -2028,6 +2018,11 @@ struct wcn36xx_hal_config_bss_params {
 	/* maxTxPower has max power to be used after applying the power
 	 * constraint if any */
 	s8 max_tx_power;
+	/* sta MUST be the last field for compatibility with the WCN3680
+	 * Pronto firmware (e.g. Motorola sanders stock 1.5.1.2). With sta in
+	 * the middle, the FW miscomputes BSS context size and returns
+	 * MEM_FAIL=5 on hal_config_bss. */
+	struct wcn36xx_hal_config_sta_params sta;
 } __packed;
 
 struct wcn36xx_hal_config_bss_req_msg {
@@ -4166,6 +4161,9 @@ struct wcn36xx_hal_tx_compl_ind_msg {
 
 	/* Tx Complete Indication Success or Failure */
 	u32 status;
+
+	/* Dialog token (present in WCN3680 Pronto FW; matches prima) */
+	u32 dialog_token;
 };
 
 struct wcn36xx_hal_wlan_host_suspend_ind_msg {
