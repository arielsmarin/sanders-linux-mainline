[Unit]
Description=Restore Bluetooth MAC from /persist (sanders)
# Roda no boot independente do bluetooth.service. Se bluetooth.service
# vai subir (socket activation ou enable explicito), Before= garante
# que rodamos primeiro e nao conflitamos pelo socket mgmt do controller.
# WantedBy=bluetooth.service nao funciona se bluetooth.service estiver
# disabled (caso default no Arch ARM) — por isso usamos multi-user.target.
After=local-fs.target sys-subsystem-bluetooth-devices-hci0.device
Before=bluetooth.service
Wants=sys-subsystem-bluetooth-devices-hci0.device
ConditionPathExists=/dev/disk/by-partlabel/persist

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/sanders-bt-mac.sh

[Install]
WantedBy=multi-user.target
